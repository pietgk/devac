#!/usr/bin/env node
// Wrapper script for large repositories - increases Node.js heap size
import { spawn } from 'child_process';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Run with increased heap size (8GB)
const args = ['--max-old-space-size=8192', join(__dirname, 'dist/index.js'), ...process.argv.slice(2)];
const child = spawn('node', args, { stdio: 'inherit' });

child.on('exit', (code) => {
  process.exit(code || 0);
});
