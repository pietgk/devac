{
  "version": "1.0.0",
  "neo4j": {
    "uri": "bolt://localhost:7687",
    "username": "neo4j",
    "password": "test1234",
    "database": "devac"
  },
  "web": {
    "port": 3000,
    "host": "localhost",
    "cors": true
  },
  "services": {
    "codegraph": {
      "enabled": true,
      "directories": [
        "/Users/grop/ws/CodeGraph"
      ],
      "extensions": [
        ".ts",
        ".js",
        ".py",
        ".java",
        ".go"
      ],
      "ignore": [
        "**/node_modules/**",
        "**/.git/**"
      ],
      "watch": true
    },
    "typecheck": {
      "enabled": false,
      "repositories": []
    },
    "lint": {
      "enabled": true,
      "repositories": [
        {
          "path": "/Users/grop/ws/CodeGraph",
          "strategy": "single",
          "command": "npm run lint",
          "watch": true
        }
      ]
    },
    "test": {
      "enabled": true,
      "repositories": [
        {
          "path": "/Users/grop/ws/CodeGraph",
          "strategy": "single",
          "command": "npm run test",
          "watch": true
        }
      ]
    }
  },
  "logging": {
    "level": "info",
    "maxFileSize": "10MB",
    "maxFiles": 10
  },
  "workspace": {
    "autoDiscover": true
  }
}